// Cloudflare deployment settings for calcupine.com.
// The site is plain files built into docs/ by build.py. worker.js only answers
// /api/geo (visitor's country); every other request is served straight from docs/.
// "name" must match the Worker in the dashboard.
{
  "name": "calcupine",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
