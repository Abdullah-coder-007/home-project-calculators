// Cloudflare deployment settings for calcupine.com.
// The site is plain files built into docs/ by build.py, so Cloudflare only
// needs to serve that folder. "name" must match the Worker in the dashboard.
{
  "name": "calcupine",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
