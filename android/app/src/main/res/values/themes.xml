<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Calcupine" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#F2367C</item>
        <item name="colorAccent">#F2367C</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="BigButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#1B1640</item>
        <item name="android:background">@drawable/btn_yellow</item>
    </style>
    <style name="BigButton.Send">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/btn_pink</item>
    </style>
    <style name="SmallButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/btn_ghost</item>
    </style>
</resources>
